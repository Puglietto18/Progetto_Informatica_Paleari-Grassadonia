<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerMenu"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContenuto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
        <!-- HEADER -->
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="310dp">

                    <ImageView
                        android:id="@+id/logo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo"/>

                    <ImageButton
                        android:id="@+id/bottoneMenu"
                        android:layout_width="41dp"
                        android:layout_height="41dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="14dp"
                        android:contentDescription="Apri Menu"
                        android:padding="11dp"
                        android:src="@drawable/immagine_menu" />

                    <Button
                        android:id="@+id/bottoneCarrello"
                        android:layout_width="41dp"
                        android:layout_height="41dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="14dp"
                        android:layout_marginTop="14dp"
                        android:contentDescription="Apri Carrello"
                        android:padding="2dp"
                        android:text="🛒" />

                </FrameLayout>



                <!-- MENU CATEGORIE -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/barra_categoria"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingStart="120dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="12dp"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tabMotore"
                            style="@style/CategoriaTabStyle"
                            android:text="Motore" />

                        <TextView android:id="@+id/tabScarichi"
                            style =  "@style/CategoriaTabStyle"
                            android:text="Scarichi"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="12dp"
                    android:paddingStart="60dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="18dp">
                    <TextView
                        android:id="@+id/titoloSezione"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Componenti Motore Disponibili"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="25dp">
                        <Button
                            android:id="@+id/bottoneFiltro2Tempi"
                            android:layout_width="170dp"
                            android:layout_height="40dp"
                            android:backgroundTint="@color/barra_categoria"
                            android:text="Filtra per 2 tempi"
                            android:textColor="@color/white">
                        </Button>
                        <Button
                            android:layout_width="170dp"
                            android:layout_height="40dp"
                            android:backgroundTint="@color/barra_categoria"
                            android:text="Filtra per 4 tempi"
                            android:textColor="@color/white">
                        </Button>
                    </LinearLayout>
                </HorizontalScrollView>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    tools:listitem ="@layout/prodotto"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/barra_categoria"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="34dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">
        <TextView
            android:id="@+id/tvTitoloMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MotoParts"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/tvStatoLogIn"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:layout_marginTop="6dp"
            android:text="Non hai ancora effettuato il login..."
            android:textColor="@color/white"
            android:textSize="14sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="22dp"
            android:background="@color/barra_categoria"/>

        <TextView
            android:id="@+id/tvTitoloLogin"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="@string/login"
            android:textColor="@color/white"
            android:textSize="20sp"/>

        <EditText
            android:id="@+id/etEmailUtente"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/drawer_input"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/white"/>

        <EditText
            android:id="@+id/etPasswordUtente"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_input"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/white"/>

        <EditText
            android:id="@+id/etConfermaPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_input"
            android:hint="Conferma Password"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#C91515"
            android:text="@string/login"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btnRegistrati"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/barra_categoria"
            android:text="@string/registrati"
            android:textColor="@color/white"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnVaiaRegistrati"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/barra_categoria"
            android:text="@string/vaiARegistrati"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btnVaiaLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/barra_categoria"
            android:text="@string/vaiALogin"
            android:textColor="@color/white"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/barra_categoria"
            android:textColor="#C91515"
            android:text="@string/logout"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>

